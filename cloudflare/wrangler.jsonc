{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "audio-crawler",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": { "binding": "BROWSER" },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
